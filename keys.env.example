# ---- Livepeer Agent -------------------------------------------------------
LIVEPEER_MCP_URL=https://agent.livepeer.org/api/mcp
# mock = canned assets, no credits spent. real = generate on Livepeer Agent.
LIVEPEER_MODE=mock
# Empty = keyless demo credits (verified for afrinxnahar@gmail.com on the network).
LIVEPEER_AGENT_KEY=
# ---- Supabase (required for login; without the service key data goes to .data/db.json)
SUPABASE_URL=
# Project Settings > API Keys. Publishable key (or legacy anon key) is used for Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=pitches
# OAuth providers you enabled under Authentication > Sign In / Providers, comma separated
AUTH_PROVIDERS=google,github
# Only for `npm run seed`: password for the demo logins it creates (leave empty to skip them)
DEMO_PASSWORD=
# ---- Redis / BullMQ (optional: without it the job chain runs inline) ------
REDIS_URL=
# ---- Other -----------------------------------------------------------------
VARIANTS_PER_PITCH=3
# Daydream key (not accepted by the Livepeer Agent MCP, kept for Daydream APIs)
DAYDREAM_API_KEY=
